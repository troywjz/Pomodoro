import { ComboBox, Switch } from "std-widgets.slint";

component ActionButton inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> primary;
    in-out property <bool> dark;
    in-out property <bool> enabled: true;
    in-out property <float> font-scale: 1;
    in property <string> icon-path;
    in property <bool> circular;
    callback clicked();
    out property <bool> has-focus: button-focus.has-focus;
    forward-focus: button-focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    background: circular ? transparent : !enabled ? (dark ? #252a34 : #e8ebf0)
        : primary ? (dark ? #91a7ff : #4263eb)
        : (dark ? #252c39 : #edf1ff);
    border-color: primary ? (dark ? #91a7ff : #4263eb)
        : (dark ? #394152 : #cbd3df);
    border-width: circular ? 0px : 1px;
    border-radius: (circular ? 20 : 9) * root.font-scale * 1px;

    if root.icon-path == "": Text {
        text: label;
        color: !enabled ? (dark ? #7d8490 : #9aa2af)
            : primary ? (dark ? #151a25 : #ffffff)
            : (dark ? #f3f5f8 : #182236);
        font-family: "Microsoft YaHei UI";
        font-size: 14 * root.font-scale * 1px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.icon-path != "": Path {
        width: 16 * root.font-scale * 1px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.icon-path;
        fill: root.dark ? #f3f5f8 : #182236;
    }

    TouchArea {
        enabled: parent.enabled;
        clicked => { parent.clicked(); }
    }
    button-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if root.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        background: transparent;
        border-color: root.dark ? #f3f5f8 : #182236;
        border-width: 2px;
        border-radius: root.border-radius;
    }
}

component ProgressRing inherits Rectangle {
    in-out property <float> progress;
    in-out property <bool> dark;
    in-out property <bool> compact;
    in-out property <color> accent;
    in-out property <string> progress-path;
    in-out property <float> layout-scale: 1;

    width: (compact ? 44 : 52) * layout-scale * 1px;
    height: (compact ? 44 : 52) * layout-scale * 1px;
    background: transparent;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: compact ? 44 : 52;
        viewbox-height: compact ? 44 : 52;
        commands: compact
            ? "M 22 2 A 20 20 0 1 1 21.99 2"
            : "M 26 2 A 24 24 0 1 1 25.99 2";
        stroke: dark ? #343b49 : #e5eaf2;
        stroke-width: (compact ? 4 : 5) * root.layout-scale * 1px;
        fill: transparent;
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: compact ? 44 : 52;
        viewbox-height: compact ? 44 : 52;
        commands: root.progress-path;
        stroke: accent;
        stroke-width: (compact ? 4 : 5) * root.layout-scale * 1px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

component SettingRow inherits Rectangle {
    in-out property <bool> dark;
    in property <float> scale: 1;
    in-out property <string> title;
    in-out property <int> value;
    in-out property <string> suffix;
    callback decrement();
    callback increment();
    height: 26 * root.scale * 1px;
    background: transparent;
    HorizontalLayout {
        spacing: 5 * root.scale * 1px;
        Text {
            text: root.title;
            color: root.dark ? #f3f5f8 : #182236;
            font-family: "Microsoft YaHei UI";
            font-size: 13 * root.scale * 1px;
            vertical-alignment: center;
            width: 56 * root.scale * 1px;
        }
        ActionButton { label: "−"; primary: false; dark: root.dark; font-scale: root.scale; width: 25 * root.scale * 1px; height: 26 * root.scale * 1px; clicked => { root.decrement(); } }
        Text {
            text: root.value + " " + root.suffix;
            color: root.dark ? #f3f5f8 : #182236;
            font-family: "Microsoft YaHei UI";
            font-size: 13 * root.scale * 1px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 39 * root.scale * 1px;
        }
        ActionButton { label: "+"; primary: false; dark: root.dark; font-scale: root.scale; width: 25 * root.scale * 1px; height: 26 * root.scale * 1px; clicked => { root.increment(); } }
    }
}

export component PomodoroWindow inherits Window {
    in property <bool> keep-on-top;
    always-on-top: root.keep-on-top;
    in-out property <length> target-width: 192px;
    in-out property <int> page: 0;
    out property <length> target-height: (page == 1 ? (feedback == "" ? 329 : 367)
        : page == 2 ? 134 : (expanded ? (feedback == "" ? 164 : 202) : 72)
            + (show-wall-clock ? 22 : 0))
        * root.layout-scale * 1px;
    in-out property <int> draft-focus: 25;
    in-out property <int> draft-short: 5;
    in-out property <int> draft-long: 15;
    in-out property <int> draft-rounds: 4;
    in-out property <bool> draft-topmost;
    in-out property <bool> draft-show-wall-clock;
    in-out property <int> draft-wall-clock-zone;
    in property <bool> show-wall-clock;
    in property <string> wall-clock-label;
    in property <[string]> wall-clock-zones;
    in-out property <string> progress-path: "M 26 2 A 24 24 0 1 1 26 50 A 24 24 0 1 1 26 2";
    in-out property <bool> dark;
    in-out property <bool> expanded: true;
    in-out property <bool> recovering;
    in-out property <bool> running;
    in-out property <bool> paused;
    in-out property <bool> completed;
    in-out property <string> phase-title;
    in-out property <string> round-label;
    in-out property <string> time-label;
    in-out property <string> status-label;
    in-out property <string> save-label;
    in-out property <string> feedback;
    in-out property <float> progress;
    in-out property <color> accent: dark ? #91a7ff : #4263eb;
    in-out property <float> layout-scale: target-width / 192px;

    callback start-requested();
    callback pause-requested();
    callback resume-requested();
    callback end-requested();
    callback next-requested();
    callback recovery-continue-requested();
    callback recovery-discard-requested();
    callback toggle-requested();
    callback settings-requested();
    callback page-requested(int);
    callback save-requested(int, int, int, int, bool, bool, int);
    callback cancel-requested();
    callback exit-requested();

    no-frame: true;
    width: target-width;
    height: target-height;
    background: transparent;

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        background: dark ? #171b24 : #ffffff;
        border-color: dark ? #394152 : #cbd3df;
        border-width: 1px;
        border-radius: 16 * root.layout-scale * 1px;

        if root.page == 0: VerticalLayout {
            padding: 9 * root.layout-scale * 1px;
            spacing: 6 * root.layout-scale * 1px;

            if root.show-wall-clock: Text {
                text: root.wall-clock-label;
                color: root.dark ? #f3f5f8 : #182236;
                font-size: 11 * root.layout-scale * 1px;
                height: 16 * root.layout-scale * 1px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8 * root.layout-scale * 1px;
                alignment: center;
                height: 52 * root.layout-scale * 1px;

                ProgressRing {
                    progress: root.progress;
                    dark: root.dark;
                    compact: false;
                    layout-scale: root.layout-scale;
                    accent: root.accent;
                    progress-path: root.progress-path;

                    ActionButton {
                        width: 36 * root.layout-scale * 1px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        label: root.completed ? "下一段" : (root.running ? "暂停"
                            : (root.paused || root.recovering ? "继续" : "开始"));
                        icon-path: root.completed ? "M 3 2 L 11 8 L 3 14 Z M 12 2 H 14 V 14 H 12 Z"
                            : root.running ? "M 4 3 H 7 V 13 H 4 Z M 9 3 H 12 V 13 H 9 Z"
                            : "M 5 2 L 14 8 L 5 14 Z";
                        circular: true;
                        dark: root.dark;
                        font-scale: root.layout-scale;
                        clicked => {
                            if (root.recovering) { root.recovery-continue-requested(); }
                            else if (root.completed) { root.next-requested(); }
                            else if (root.running) { root.pause-requested(); }
                            else if (root.paused) { root.resume-requested(); }
                            else { root.start-requested(); }
                        }
                    }
                }
                WindowMoveArea {
                    min-width: 72 * root.layout-scale * 1px;
                    max-width: self.min-width;
                    Text {
                        text: root.time-label;
                        accessible-label: root.phase-title + "，剩余时间，" + root.time-label;
                        color: dark ? #f3f5f8 : #182236;
                        font-family: "Microsoft YaHei UI";
                        font-size: 23 * root.layout-scale * 1px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 30 * root.layout-scale * 1px;
                    ActionButton {
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        height: self.width;
                        label: root.expanded ? "收起" : "展开";
                        icon-path: root.expanded ? "M 3 10 L 8 5 L 13 10 L 11.5 11.5 L 8 8 L 4.5 11.5 Z"
                            : "M 3 6 L 8 11 L 13 6 L 11.5 4.5 L 8 8 L 4.5 4.5 Z";
                        dark: root.dark;
                        font-scale: root.layout-scale;
                        clicked => { root.toggle-requested(); }
                    }
                }
            }

            if root.expanded: WindowMoveArea {
                height: 20 * root.layout-scale * 1px;
                Text {
                    text: root.phase-title + "  ·  " + (root.recovering ? "待恢复" : root.round-label);
                    color: dark ? #f3f5f8 : #182236;
                    font-family: "Microsoft YaHei UI";
                    font-size: 14 * root.layout-scale * 1px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.expanded: HorizontalLayout {
                spacing: 7 * root.layout-scale * 1px;
                height: 30 * root.layout-scale * 1px;
                ActionButton {
                    label: root.recovering ? "放弃本段" : "提前结束";
                    enabled: root.recovering || root.running || root.paused;
                    dark: root.dark;
                    font-scale: root.layout-scale;
                    clicked => {
                        if (root.recovering) { root.recovery-discard-requested(); }
                        else { root.end-requested(); }
                    }
                }
                ActionButton { label: "设置"; dark: root.dark; font-scale: root.layout-scale; clicked => { root.settings-requested(); } }
            }
            if root.expanded && root.feedback != "": Text {
                text: root.feedback;
                color: dark ? #ffb4bd : #b42335;
                font-family: "Microsoft YaHei UI";
                font-size: 12 * root.layout-scale * 1px;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                height: 32 * root.layout-scale * 1px;
            }
            if root.expanded: ActionButton {
                label: "退出";
                dark: root.dark;
                font-scale: root.layout-scale;
                height: 24 * root.layout-scale * 1px;
                clicked => { root.exit-requested(); }
            }
        }

        if root.page == 1: VerticalLayout {
            padding: 9 * root.layout-scale * 1px;
            spacing: 6 * root.layout-scale * 1px;
            WindowMoveArea {
                height: 22 * root.layout-scale * 1px;
                Text {
                    text: "设置";
                    color: dark ? #f3f5f8 : #182236;
                    font-size: 16 * root.layout-scale * 1px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            SettingRow { dark: root.dark; scale: root.layout-scale; title: "专注"; value: root.draft-focus; suffix: "分"; decrement => { root.draft-focus = max(1, root.draft-focus - 1); } increment => { root.draft-focus = min(180, root.draft-focus + 1); } }
            SettingRow { dark: root.dark; scale: root.layout-scale; title: "短休"; value: root.draft-short; suffix: "分"; decrement => { root.draft-short = max(1, root.draft-short - 1); } increment => { root.draft-short = min(60, root.draft-short + 1); } }
            SettingRow { dark: root.dark; scale: root.layout-scale; title: "长休"; value: root.draft-long; suffix: "分"; decrement => { root.draft-long = max(1, root.draft-long - 1); } increment => { root.draft-long = min(120, root.draft-long + 1); } }
            SettingRow { dark: root.dark; scale: root.layout-scale; title: "长休间隔"; value: root.draft-rounds; suffix: "轮"; decrement => { root.draft-rounds = max(1, root.draft-rounds - 1); } increment => { root.draft-rounds = min(12, root.draft-rounds + 1); } }
            Switch { text: "窗口置顶"; checked <=> root.draft-topmost; height: 26 * root.layout-scale * 1px; }
            Switch { text: "显示当前时间"; checked <=> root.draft-show-wall-clock; height: 26 * root.layout-scale * 1px; }
            HorizontalLayout {
                spacing: 6 * root.layout-scale * 1px;
                height: 28 * root.layout-scale * 1px;
                Text {
                    text: "时区";
                    color: root.dark ? #f3f5f8 : #182236;
                    font-size: 13 * root.layout-scale * 1px;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.wall-clock-zones;
                    current-index <=> root.draft-wall-clock-zone;
                    accessible-label: "时区";
                    horizontal-stretch: 1;
                }
            }
            if root.feedback != "": Text {
                text: root.feedback;
                color: dark ? #ffb4bd : #b42335;
                font-size: 12 * root.layout-scale * 1px;
                wrap: word-wrap;
                height: 32 * root.layout-scale * 1px;
            }
            HorizontalLayout {
                height: 28 * root.layout-scale * 1px;
                spacing: 6 * root.layout-scale * 1px;
                ActionButton {
                    label: "保存"; primary: true; dark: root.dark; font-scale: root.layout-scale;
                    clicked => { root.save-requested(root.draft-focus, root.draft-short, root.draft-long, root.draft-rounds, root.draft-topmost, root.draft-show-wall-clock, root.draft-wall-clock-zone); }
                }
                ActionButton { label: "取消"; dark: root.dark; font-scale: root.layout-scale; clicked => { root.cancel-requested(); } }
            }
            ActionButton { label: "关于"; dark: root.dark; font-scale: root.layout-scale; height: 24 * root.layout-scale * 1px; clicked => { root.page-requested(2); } }
        }

        if root.page == 2: VerticalLayout {
            padding: 9 * root.layout-scale * 1px;
            spacing: 6 * root.layout-scale * 1px;
            WindowMoveArea {
                height: 23 * root.layout-scale * 1px;
                Text {
                    text: "关于番茄钟";
                    color: dark ? #f3f5f8 : #182236;
                    font-size: 16 * root.layout-scale * 1px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text { text: "界面由 Slint 支持 · Slint 1.19"; color: dark ? #b4bdcc : #596579; font-size: 12 * root.layout-scale * 1px; height: 19 * root.layout-scale * 1px; }
            Text { text: "slint.dev"; color: dark ? #91a7ff : #4263eb; font-size: 12 * root.layout-scale * 1px; height: 18 * root.layout-scale * 1px; }
            ActionButton { label: "返回设置"; primary: true; dark: root.dark; font-scale: root.layout-scale; height: 30 * root.layout-scale * 1px; clicked => { root.page-requested(1); } }
        }
    }
}
