component ActionButton inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> primary;
    in-out property <bool> dark;
    in-out property <bool> enabled: true;
    in-out property <float> font-scale: 1;
    callback clicked();
    out property <bool> has-focus: button-focus.has-focus;
    forward-focus: button-focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    background: !enabled ? (dark ? #252a34 : #e8ebf0)
        : primary ? (dark ? #91a7ff : #4263eb)
        : (dark ? #252c39 : #edf1ff);
    border-color: primary ? (dark ? #91a7ff : #4263eb)
        : (dark ? #394152 : #cbd3df);
    border-width: 1px;
    border-radius: 9 * root.font-scale * 1px;

    Text {
        text: label;
        color: !enabled ? (dark ? #7d8490 : #9aa2af)
            : primary ? (dark ? #151a25 : #ffffff)
            : (dark ? #f3f5f8 : #182236);
        font-family: "Microsoft YaHei UI";
        font-size: 14 * root.font-scale * 1px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: parent.enabled;
        clicked => { parent.clicked(); }
    }
    button-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if root.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        background: transparent;
        border-color: root.dark ? #f3f5f8 : #182236;
        border-width: 2px;
        border-radius: root.border-radius;
    }
}

component ProgressRing inherits Rectangle {
    in-out property <float> progress;
    in-out property <bool> dark;
    in-out property <bool> compact;
    in-out property <color> accent;
    in-out property <string> progress-path;
    in-out property <float> layout-scale: 1;

    width: (compact ? 44 : 52) * layout-scale * 1px;
    height: (compact ? 44 : 52) * layout-scale * 1px;
    background: transparent;

    Path {
        width: parent.width;
        height: parent.height;
        commands: compact
            ? "M 22 2 A 20 20 0 1 1 21.99 2"
            : "M 26 2 A 24 24 0 1 1 25.99 2";
        stroke: dark ? #343b49 : #e5eaf2;
        stroke-width: (compact ? 4 : 5) * root.layout-scale * 1px;
        fill: transparent;
    }

    Path {
        width: parent.width;
        height: parent.height;
        commands: root.progress-path;
        stroke: accent;
        stroke-width: (compact ? 4 : 5) * root.layout-scale * 1px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

export component PomodoroWindow inherits Window {
    in-out property <length> target-width: 192px;
    in-out property <string> progress-path: "M 26 2 A 24 24 0 1 1 26 50 A 24 24 0 1 1 26 2";
    in-out property <bool> dark;
    in-out property <bool> expanded: true;
    in-out property <bool> recovering;
    in-out property <bool> running;
    in-out property <bool> paused;
    in-out property <bool> completed;
    in-out property <string> phase-title;
    in-out property <string> round-label;
    in-out property <string> time-label;
    in-out property <string> status-label;
    in-out property <string> save-label;
    in-out property <string> feedback;
    in-out property <float> progress;
    in-out property <color> accent: dark ? #91a7ff : #4263eb;
    in-out property <float> layout-scale: target-width / 192px;

    callback start-requested();
    callback pause-requested();
    callback resume-requested();
    callback end-requested();
    callback next-requested();
    callback recovery-continue-requested();
    callback recovery-pause-requested();
    callback recovery-discard-requested();
    callback toggle-requested();
    callback settings-requested();
    callback about-requested();

    width: target-width;
    height: (expanded ? 300 : 88) * root.layout-scale * 1px;
    background: dark ? #171b24 : #ffffff;

    Rectangle {
        background: dark ? #171b24 : #ffffff;
        border-color: dark ? #394152 : #cbd3df;
        border-width: 1px;
        border-radius: 16 * root.layout-scale * 1px;

        if expanded: VerticalLayout {
            padding: 11 * root.layout-scale * 1px;
            spacing: 7 * root.layout-scale * 1px;

            Text {
                text: phase-title + "  ·  " + round-label;
                color: dark ? #f3f5f8 : #182236;
                font-family: "Microsoft YaHei UI";
                font-size: 14 * root.layout-scale * 1px;
                font-weight: 700;
                vertical-alignment: center;
                height: 21 * root.layout-scale * 1px;
            }

            HorizontalLayout {
                spacing: 10 * root.layout-scale * 1px;
                alignment: center;
                height: 56 * root.layout-scale * 1px;

                ProgressRing {
                    progress: root.progress;
                    dark: root.dark;
                    compact: false;
                    layout-scale: root.layout-scale;
                    accent: root.accent;
                    progress-path: root.progress-path;
                }

                Text {
                    text: root.time-label;
                    accessible-label: root.phase-title + "，剩余时间，" + root.time-label;
                    color: dark ? #f3f5f8 : #182236;
                    font-family: "Microsoft YaHei UI";
                    font-size: 25 * root.layout-scale * 1px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.recovering ? "选择恢复方式" : "";
                color: dark ? #b4bdcc : #596579;
                font-family: "Microsoft YaHei UI";
                font-size: 12 * root.layout-scale * 1px;
                height: 16 * root.layout-scale * 1px;
                vertical-alignment: center;
            }

            if recovering: HorizontalLayout {
                spacing: 6 * root.layout-scale * 1px;
                height: 38 * root.layout-scale * 1px;
                ActionButton {
                    label: "继续";
                    primary: true;
                    dark: root.dark;
                    font-scale: root.layout-scale;
                    clicked => { root.recovery-continue-requested(); }
                }
                ActionButton {
                    label: "保持暂停";
                    primary: false;
                    dark: root.dark;
                    font-scale: root.layout-scale;
                    clicked => { root.recovery-pause-requested(); }
                }
            }
            if !recovering: ActionButton {
                height: 40 * root.layout-scale * 1px;
                label: root.completed ? "下一段" : (root.running ? "暂停" : (root.paused ? "继续" : "开始"));
                primary: true;
                dark: root.dark;
                font-scale: root.layout-scale;
                clicked => {
                    if (root.completed) { root.next-requested(); }
                    else if (root.running) { root.pause-requested(); }
                    else if (root.paused) { root.resume-requested(); }
                    else { root.start-requested(); }
                }
            }

            if recovering: ActionButton {
                label: "放弃本段";
                primary: false;
                dark: root.dark;
                font-scale: root.layout-scale;
                height: 24 * root.layout-scale * 1px;
                clicked => { root.recovery-discard-requested(); }
            }
            if !recovering: HorizontalLayout {
                spacing: 7 * root.layout-scale * 1px;
                height: 32 * root.layout-scale * 1px;
                ActionButton {
                    label: "提前结束";
                    primary: false;
                    dark: root.dark;
                    font-scale: root.layout-scale;
                    enabled: root.running || root.paused;
                    clicked => { root.end-requested(); }
                }
                ActionButton {
                    label: "设置";
                    primary: false;
                    dark: root.dark;
                    font-scale: root.layout-scale;
                    clicked => { root.settings-requested(); }
                }
            }

            Text {
                text: root.feedback;
                color: dark ? #ffb4bd : #b42335;
                font-family: "Microsoft YaHei UI";
                font-size: 12 * root.layout-scale * 1px;
                visible: root.feedback != "";
                horizontal-alignment: center;
                vertical-alignment: center;
                height: 15 * root.layout-scale * 1px;
            }

            HorizontalLayout {
                spacing: 0px;
                ActionButton { label: "关于"; primary: false; dark: root.dark; font-scale: root.layout-scale; height: 24 * root.layout-scale * 1px; clicked => { root.about-requested(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                ActionButton { label: "收起"; primary: false; dark: root.dark; font-scale: root.layout-scale; height: 24 * root.layout-scale * 1px; clicked => { root.toggle-requested(); } }
            }
        }

        if !expanded: HorizontalLayout {
            padding: 8 * root.layout-scale * 1px;
            spacing: 8 * root.layout-scale * 1px;
            alignment: center;

            ProgressRing {
                progress: root.progress;
                dark: root.dark;
                compact: true;
                layout-scale: root.layout-scale;
                accent: root.accent;
                progress-path: root.progress-path;
            }
            Text {
                text: root.time-label;
                color: dark ? #f3f5f8 : #182236;
                font-family: "Microsoft YaHei UI";
                accessible-label: root.phase-title + "，剩余时间，" + root.time-label;
                font-size: 19 * root.layout-scale * 1px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            ActionButton { label: "展开"; primary: false; dark: root.dark; font-scale: root.layout-scale; height: 36 * root.layout-scale * 1px; clicked => { root.toggle-requested(); } }
        }
    }
}

component SettingRow inherits Rectangle {
    in-out property <bool> dark;
    in-out property <string> title;
    in-out property <int> value;
    in-out property <string> suffix;
    callback decrement();
    callback increment();
    height: 38px;
    background: transparent;
    HorizontalLayout {
        spacing: 5px;
        Text {
            text: root.title;
            color: root.dark ? #f3f5f8 : #182236;
            font-family: "Microsoft YaHei UI";
            font-size: 13px;
            vertical-alignment: center;
            width: 64px;
        }
        ActionButton { label: "−"; primary: false; dark: root.dark; width: 30px; height: 32px; clicked => { root.decrement(); } }
        Text {
            text: root.value + " " + root.suffix;
            color: root.dark ? #f3f5f8 : #182236;
            font-family: "Microsoft YaHei UI";
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 74px;
        }
        ActionButton { label: "+"; primary: false; dark: root.dark; width: 30px; height: 32px; clicked => { root.increment(); } }
    }
}

export component SettingsWindow inherits Window {
    in-out property <bool> dark;
    in-out property <int> focus-minutes: 25;
    in-out property <int> short-minutes: 5;
    in-out property <int> long-minutes: 15;
    in-out property <int> rounds: 4;
    in-out property <int> draft-focus: root.focus-minutes;
    in-out property <int> draft-short: root.short-minutes;
    in-out property <int> draft-long: root.long-minutes;
    in-out property <int> draft-rounds: root.rounds;
    callback focus-delta(int);
    callback short-delta(int);
    callback long-delta(int);
    callback rounds-delta(int);
    callback close-requested();
    callback save-requested(int, int, int, int);
    callback cancel-requested();

    width: 248px;
    height: 350px;
    background: dark ? #171b24 : #ffffff;

    Rectangle {
        background: dark ? #171b24 : #ffffff;
        border-color: dark ? #394152 : #cbd3df;
        border-width: 1px;
        border-radius: 14px;
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            Text {
                text: "计时设置";
                color: dark ? #f3f5f8 : #182236;
                font-family: "Microsoft YaHei UI";
                font-size: 18px;
                font-weight: 700;
                height: 26px;
            }
            SettingRow { dark: root.dark; title: "专注"; value: root.draft-focus; suffix: "分钟"; decrement => { root.draft-focus = max(1, root.draft-focus - 1); } increment => { root.draft-focus = min(180, root.draft-focus + 1); } }
            SettingRow { dark: root.dark; title: "短休"; value: root.draft-short; suffix: "分钟"; decrement => { root.draft-short = max(1, root.draft-short - 1); } increment => { root.draft-short = min(60, root.draft-short + 1); } }
            SettingRow { dark: root.dark; title: "长休"; value: root.draft-long; suffix: "分钟"; decrement => { root.draft-long = max(1, root.draft-long - 1); } increment => { root.draft-long = min(120, root.draft-long + 1); } }
            SettingRow { dark: root.dark; title: "长休间隔"; value: root.draft-rounds; suffix: "轮"; decrement => { root.draft-rounds = max(1, root.draft-rounds - 1); } increment => { root.draft-rounds = min(12, root.draft-rounds + 1); } }
            ActionButton {
                label: "保存";
                primary: true;
                dark: root.dark;
                height: 38px;
                clicked => {
                    root.save-requested(root.draft-focus, root.draft-short, root.draft-long, root.draft-rounds);
                }
            }
            ActionButton {
                label: "取消";
                primary: false;
                dark: root.dark;
                height: 32px;
                clicked => { root.cancel-requested(); }
            }
        }
    }
}

export component AboutWindow inherits Window {
    in-out property <bool> dark;
    callback close-requested();
    width: 248px;
    height: 170px;
    background: dark ? #171b24 : #ffffff;
    Rectangle {
        background: dark ? #171b24 : #ffffff;
        border-color: dark ? #394152 : #cbd3df;
        border-width: 1px;
        border-radius: 14px;
        VerticalLayout {
            padding: 16px;
            spacing: 9px;
            Text { text: "番茄钟"; color: dark ? #f3f5f8 : #182236; font-family: "Microsoft YaHei UI"; font-size: 18px; font-weight: 700; height: 24px; }
            Text { text: "界面由 Slint 支持 · Slint 1.19"; color: dark ? #b4bdcc : #596579; font-family: "Microsoft YaHei UI"; font-size: 13px; height: 20px; }
            Text { text: "slint.dev"; color: dark ? #91a7ff : #4263eb; font-family: "Microsoft YaHei UI"; font-size: 13px; height: 20px; }
            ActionButton { label: "关闭"; primary: true; dark: root.dark; height: 36px; clicked => { root.close-requested(); } }
        }
    }
}
